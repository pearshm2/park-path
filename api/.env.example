# Copy to .env for local (non-docker) dev: `cp .env.example .env`
# docker-compose already sets these for you via docker-compose.yml,
# so this file only matters if you run uvicorn directly on your machine.

DATABASE_URL=postgresql://parkpath:parkpath@localhost:5432/parkpath
ENVIRONMENT=development
CORS_ORIGINS=*

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real value — this is fine for local dev only.
SECRET_KEY=dev-only-insecure-secret-change-me

# Only needed to run the live NPS sync (python -m app.nps_sync).
# Get your own free key at https://api.data.gov/signup — don't share keys.
# python -m app.nps_sync --from-snapshot
NPS_API_KEY=
# Trip photo storage (leave empty until the S3 bucket exists; trips work without it).
# S3_BUCKET=parkpath-photos
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google sign-in (app/google_auth.py): the OAuth client ids from Google
# Cloud, comma-separated (the web one, and the iOS one). Empty = off.
# GOOGLE_CLIENT_IDS=1234-abc.apps.googleusercontent.com,1234-def.apps.googleusercontent.com
