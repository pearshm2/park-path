# Base URL of the ParkPath API. Expo inlines EXPO_PUBLIC_* at build time,
# so restart the dev server after changing this.
#
# Browser on the same machine as the API (the web demo):
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Expo Go on a physical phone: localhost is the phone itself, so use your
# computer's LAN address instead, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Google sign-in (see src/auth/googleSignIn.ts). OAuth client ids from
# Google Cloud -> APIs & Services -> Credentials. Leave empty to keep the
# button saying it isn't set up. Only works in a development build.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-def.apps.googleusercontent.com
