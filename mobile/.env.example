# Base URL of the ParkPath API. Expo inlines EXPO_PUBLIC_* at build time,
# so restart the dev server after changing this.
#
# Browser on the same machine as the API (the web demo):
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Expo Go on a physical phone: localhost is the phone itself, so use your
# computer's LAN address instead, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
